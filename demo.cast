[0.064, "o", "***Операции с данными***\r\n\r\nФункции:\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r\n<command> select from <имя_таблицы> - прочитать все записи.\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись.\r\n<command> info <имя_таблицы> - вывести информацию о таблице.\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n"]
[0.000, "o", ">>>Введите команду: "]
[4.576, "o", "create_table users name:str age:int is_active:bool"]
[0.533, "o", "\r\n"]
[0.001, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[0.003, "o", ">>>Введите команду: "]
[5.650, "o", "insert into users values (\"Sergei\", 28, true)"]
[0.605, "o", "\r\n"]
[0.000, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[0.004, "o", ">>>Введите команду: "]
[3.433, "o", "insert into users values (\"Anna\", 34, false)"]
[0.430, "o", "\r\n"]
[0.001, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\".\r\n"]
[0.002, "o", ">>>Введите команду: "]
[3.839, "o", "select from users"]
[0.430, "o", "\r\n"]
[0.353, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n| 2  |  Anna  |  34 |   False   |\r\n+----+--------+-----+-----------+\r\n"]
[0.000, "o", ">>>Введите команду: "]
[6.085, "o", "update users set age = 29 where name = \"Sergei\""]
[0.499, "o", "\r\n"]
[0.002, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[0.007, "o", ">>>Введите команду: "]
[11.061, "o", "info users"]
[0.365, "o", "\r\n"]
[0.002, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 2\r\n"]
[0.004, "o", ">>>Введите команду: "]
[2.828, "o", "delete from users where ID = 1"]
[0.448, "o", "\r\n"]
[0.002, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n"]
